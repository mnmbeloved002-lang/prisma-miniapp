{
  "name": "Prisma MiniApp Dev (L2 Stable - Recovery)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bullseye",
  
  // УДАЛЕНЫ ВСЕ features (pnpm, chrome), вызывающие ошибку аутентификации.
  "features": {}, 

  // Установка pnpm и Chromium перенесена в надежный postCreateCommand (apt).
  "postCreateCommand": "npm install -g pnpm && sudo apt-get update && sudo apt-get install -y chromium-browser", 

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "remoteUser": "node"
}
