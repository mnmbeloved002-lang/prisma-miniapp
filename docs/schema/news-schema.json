{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News Feed (MiniApp)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "date", "url", "tags"],
    "properties": {
      "id": { "type": "string", "format": "uuid" },
      "title": {
        "type": "string",
        "minLength": 10,
        "maxLength": 180,
        "pattern": "^(?!.*[<>]).+$"
      },
      "preview": {
        "type": "string",
        "minLength": 0,
        "maxLength": 240,
        "pattern": "^(?!.*[<>]).*$"
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": { "type": "string", "minLength": 2, "maxLength": 24 }
      },
      "date": { "type": "string", "format": "date-time", "pattern": "Z$" },
      "url": { "type": "string", "format": "uri", "pattern": "^https://.+" }
    }
  }
}
