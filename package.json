{
  "name": "prisma-miniapp",
  "version": "0.0.0",
  "private": true,
  "description": "Phase 0 (L1.8.2) • Vite + React + TypeScript • WSL2 Ubuntu • pnpm",
  "author": "Prisma Dev Team",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "lint": "eslint src api vite.config.ts",
    "size": "size-limit",
    "mutation": "stryker run",
    "a11y": "playwright test -c playwright.a11y.config.ts",
    "vr": "playwright test tests/e2e/smoke.spec.ts -g \"screenshot\" || true",
    "dev": "vite",
    "build": "node ./scripts/branch-guard.mjs && tsc && vite build",
    "preview": "vite preview --strictPort --port 4173 --host",
    "serve:dist": "node scripts/serve-dist.js",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "sanity": "pnpm run lint && pnpm run typecheck && pnpm run test:cov && pnpm run pkg:lint && pnpm run audit && pnpm run build && pnpm run size && pnpm run lhci",
    "sanity:ci": "pnpm run lint && pnpm run typecheck && pnpm run test:cov && pnpm run pkg:lint && pnpm run audit && pnpm run build && pnpm run size",
    "postinstall": "husky",
    "pkg:lint": "npmPkgJsonLint .",
    "audit": "pnpm audit --prod --audit-level=moderate",
    "test": "vitest run",
    "test:all": "pnpm run lint && pnpm run typecheck && pnpm run test:cov && pnpm run build && pnpm run e2e && CHROME_PATH=/usr/bin/chromium lhci autorun --config=lighthouserc.json --collect.staticDistDir=dist --collect.numberOfRuns=1 --collect.settings.chromeFlags='--no-sandbox --disable-dev-shm-usage' --upload.target=filesystem",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lhci": "CHROME_PATH=/usr/bin/chromium lhci autorun --config=lighthouserc.json --collect.staticDistDir=dist --collect.numberOfRuns=1 --collect.settings.chromeFlags=\"--no-sandbox --disable-dev-shm-usage\" --upload.target=filesystem",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ci": "playwright test --reporter=line",
    "cov:gaps": "node scripts/coverage-gaps.mjs",
    "cov:full": "pnpm vitest run --coverage && node scripts/coverage-gaps.mjs -c",
    "test:ci": "vitest run -c vitest.ci.config.ts --coverage --reporter=dot",
    "sec:osv": "npx -y osv-scanner --lockfile=pnpm-lock.yaml --recursive --fail-on=high",
    "sec:semgrep": "npx -y @semgrep/cli@1 semgrep ci --config p/ci",
    "sec:all": "pnpm sec:osv && pnpm sec:semgrep",
    "e2e:vis": "playwright test -c playwright.visual.config.ts",
    "e2e:smoke": "playwright test -c playwright.smoke.config.ts",
    "e2e:a11y": "playwright test -c playwright.a11y.config.ts",
    "e2e:visual": "playwright test -c playwright.visual.config.ts",
    "e2e:quick": "pnpm -s e2e:smoke && pnpm -s e2e:a11y && pnpm -s e2e:visual",
    "lh:ci": "lhci autorun --collect.staticDistDir=dist --upload.target=filesystem"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@size-limit/file": "^11.2.0",
    "@size-limit/preset-app": "^11.2.0",
    "@stryker-mutator/core": "^9.3.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.12.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vercel/node": "^5.5.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.4.0",
    "husky": "^9.0.10",
    "jsdom": "^27.0.1",
    "lint-staged": "^15.2.0",
    "npm-package-json-lint": "^9.0.0",
    "npm-package-json-lint-config-default": "^8.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.1",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^5.4.0",
    "vitest": "^4.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "npmpackagejsonlint": {
    "extends": "npm-package-json-lint-config-default",
    "rules": {
      "require-author": "off",
      "require-description": "error",
      "require-repository": "error",
      "no-duplicate-properties": "error",
      "require-license": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mnmbeloved002-lang/prisma-miniapp.git"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "undici": "^5.29.0",
      "path-to-regexp": "^6.3.0",
      "tar": "^7.5.2",
      "tmp": "^0.2.4"
    }
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "130 kB",
      "gzip": true
    },
    {
      "path": "dist/assets/*.css",
      "limit": "30 kB",
      "gzip": true
    }
  ],
  "knip": {
    "ignore": [
      "api/**",
      "scripts/**",
      "tests/perf/**",
      "src/setupTests.ts",
      "src/ui/NewItemsBar.tsx",
      "src/utils/usePersistentState.ts",
      "src/utils/useTTSState.ts",
      "tests/e2e/telegram-types.d.ts",
      "stryker.conf.json"
    ],
    "ignoreDependencies": [
      "zod",
      "@eslint/js",
      "eslint-config-prettier",
      "globals",
      "lint-staged",
      "@tailwindcss/typography",
      "@vercel/node",
      "autoprefixer",
      "axe-core"
    ],
    "ignoreExports": [
      "src/config.ts#FEATURES",
      "src/utils/share.ts#__hrefOrExample",
      "src/utils/share.ts#__hrefOrEmpty"
    ],
    "project": [
      "src/**/*.{ts,tsx}",
      "api/**/*.{ts,js}",
      "tests/**/*.{ts,tsx}"
    ]
  },
  "depcheck": {
    "ignores": [
      "k6"
    ]
  }
}
