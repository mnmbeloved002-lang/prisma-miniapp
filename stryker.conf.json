{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "L5 Mutation Testing: Vitest-only (TypeScript checker conflicts with Telegram SDK)",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "checkers": [],
  "vitest": {
    "configFile": "vitest.ci.config.ts"
  },
  "reporters": ["html", "clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutator": {
    "excludedMutations": ["ConsoleLogging", "StringLiteral", "ObjectLiteral"]
  },
  "mutate": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "src/infrastructure/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.mutation.test.ts",
    "!src/**/*.d.ts",
    "!src/vite-env.d.ts",
    "!src/main.tsx",
    "!src/config.ts",
    "!src/setupTests.ts",
    "!src/infrastructure/telegram.ts",
    "!src/infrastructure/sentry.ts"
  ],
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 80
  }
}
