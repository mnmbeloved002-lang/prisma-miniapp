{
  "testRunner": "command",
  "commandRunner": { 
    "command": "npx vitest run --coverage=false" 
  },
  "mutate": [
    "src/domain/*.ts",
    "src/application/*.ts",
    "src/infrastructure/*.ts",
    "src/utils/share.ts",
    "!src/**/*.test.*"
  ],
  "checkers": ["typescript"],
  "plugins": ["@stryker-mutator/typescript-checker"],
  "coverageAnalysis": "off",
  "reporters": ["html","clear-text","progress"],
  "ignorePatterns": [
    "dist",
    "coverage",
    "node_modules",
    "vite.config.js",
    "*.json"
  ]
}
