{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "L5 Mutation Testing: Maximum Quality - full coverage with strict thresholds",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "checkers": ["typescript"],
  "typescriptChecker": {},
  "vitest": {
    "configFile": "vitest.ci.config.ts"
  },
  "reporters": ["html", "clear-text", "progress", "json"],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutator": {
    "excludedMutations": ["ConsoleLogging", "StringLiteral", "ObjectLiteral"]
  },
  "mutate": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "src/application/**/*.tsx",
    "src/infrastructure/**/*.ts",
    "src/infrastructure/**/*.tsx",
    "src/ui/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.mutation.test.ts",
    "!src/**/*.d.ts",
    "!src/vite-env.d.ts",
    "!src/main.tsx",
    "!src/App.tsx",
    "!src/config.ts",
    "!src/setupTests.ts"
  ],
  "thresholds": {
    "high": 97,
    "low": 85,
    "break": 80
  }
}
