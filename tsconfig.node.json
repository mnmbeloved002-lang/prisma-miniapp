{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // UEC FIX: Мы исключаем из проверки сам конфиг vite.config.js, чтобы обойти
  //         конфликт типов плагинов, который невозможно устранить без обновления зависимостей.
  "include": ["tsconfig.node.json", "scripts/*.{ts,js,cjs}"],
  "exclude": [
    "node_modules",
    "dist",
    "vite.config.js" // Явно исключаем проблемный файл
  ]
}
